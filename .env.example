# Copy to .env and fill from Supabase Dashboard → Project Settings → API

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_public_key_here

# Optional: service_role for admin-only server scripts (never expose in browser)
# SUPABASE_SERVICE_KEY=your_service_role_key_here

# Optional: direct PostgreSQL (needs pdo_pgsql). Not required for this app.
# DATABASE_URL=postgresql://postgres.[ref]:YOUR_DB_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
